    echo "[pre-commit] Running tests (cover SVG change — guards size-gate/visual-baseline regressions)..."
  fi
  python3 -m pytest "$REPO_ROOT/scripts/tests/" -x -q 2>&1
  if [ $? -ne 0 ]; then
    echo "[pre-commit] FAILED"
    exit 1
  fi
  echo "[pre-commit] Passed."
fi

