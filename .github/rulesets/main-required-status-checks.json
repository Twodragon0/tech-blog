{
    "name": "main: required status checks",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [
        {
            "actor_id": 15368,
            "actor_type": "Integration",
            "bypass_mode": "always"
        }
    ],
    "conditions": {
        "ref_name": {
            "include": [
                "~DEFAULT_BRANCH"
            ],
            "exclude": []
        }
    },
    "rules": [
        {
            "type": "required_status_checks",
            "parameters": {
                "strict_required_status_checks_policy": false,
                "required_status_checks": [
                    {
                        "context": "ruff"
                    },
                    {
                        "context": "build"
                    },
                    {
                        "context": "Security Audit Summary"
                    },
                    {
                        "context": "CodeQL"
                    },
                    {
                        "context": "GitGuardian Security Checks"
                    }
                ]
            }
        }
    ]
}
